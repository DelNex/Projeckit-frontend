# Supabase Configuration (Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Configuration (Admin/Service Role - Never expose to client, never prefix with NEXT_PUBLIC)
# Required on the server environment for admin operations: All Accounts roster, tenant provisioning, user status management
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server-only AI Examination Generation Configuration (Never expose to client, never prefix with NEXT_PUBLIC)
# AI keys and endpoints MUST only live on the server runtime.
AI_PROVIDER_URL=https://api.openai.com/v1
AI_API_KEY=your-server-side-ai-key-here
AI_MODEL=gpt-4o-mini
AI_HOURLY_USER_LIMIT=5
AI_DAILY_SCHOOL_LIMIT=100
ALLOW_AI_DEMO_SAMPLE=false

# Optional laptop Gemini browser helper (server-only; never use NEXT_PUBLIC_)
# Set both values to enable browser-based Gemini generation. The helper takes priority over AI_PROVIDER_URL.
GEMINI_HELPER_URL=https://your-helper.trycloudflare.com
GEMINI_HELPER_TOKEN=your-long-random-helper-token
