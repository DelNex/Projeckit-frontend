# Supabase Configuration (Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only URL for the authenticated Next.js proxy to the NestJS AI service.
# Do not set this as NEXT_PUBLIC_API_BASE_URL; browser calls stay same-origin.
BACKEND_API_BASE_URL=http://localhost:4000

# Server-only Supabase privileged key for THIS SAME Supabase project.
# Use the Supabase service_role JWT / server secret key, NOT the Groq key.
# Never share this value with GROQ_API_KEY and never prefix it with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server-only Groq exam generation (never expose these values to the browser).
# This is a different provider credential from SUPABASE_SERVICE_ROLE_KEY.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Server-only exam generation quotas
AI_HOURLY_USER_LIMIT=5
AI_DAILY_SCHOOL_LIMIT=100
