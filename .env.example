# Supabase Configuration (Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only URL for the authenticated Next.js proxy to the NestJS AI service.
# Do not set this as NEXT_PUBLIC_API_BASE_URL; browser calls stay same-origin.
BACKEND_API_BASE_URL=http://localhost:4000

# Server-only Configuration (Admin/Service Role - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only exam generation quotas
AI_HOURLY_USER_LIMIT=5
AI_DAILY_SCHOOL_LIMIT=100

# Current frontend exam-generation provider:
# The Next.js app queues durable jobs in Supabase; the local Gemini helper claims,
# processes, and completes them. This is NOT a direct Groq/Gemini/OpenRouter API adapter.
# Set the same strong random value in the helper worker's HELPER_TOKEN setting.
# Keep this server-only. Never prefix it with NEXT_PUBLIC_.
GEMINI_HELPER_TOKEN=
