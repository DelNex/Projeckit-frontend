# Supabase Configuration (Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only URL for the authenticated Next.js proxy to the NestJS AI service.
# Do not set this as NEXT_PUBLIC_API_BASE_URL; browser calls stay same-origin.
BACKEND_API_BASE_URL=http://localhost:4000

# Server-only Configuration (Admin/Service Role - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI exam providers. Empty values disable that provider.
# Groq is the current primary provider on the Netlify branch deployment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional automatic failover providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://projectkit.app

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Provider order is evaluated left-to-right; providers without credentials are skipped.
AI_PROVIDER_ORDER=groq,openrouter,gemini,cloudflare
AI_PROVIDER_TIMEOUT_MS=18000
AI_PROVIDER_TOTAL_TIMEOUT_MS=50000

# Server-to-server secret for scheduled AI queue dispatch (minimum 32 characters).
# Generate a random value and set it in Netlify AND Supabase Vault.
AI_DISPATCH_CRON_SECRET=

# Server-only exam generation quotas
AI_HOURLY_USER_LIMIT=5
AI_DAILY_SCHOOL_LIMIT=100
