# Supabase Configuration (Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Configuration (Admin/Service Role - Never expose to client, never prefix with NEXT_PUBLIC)
# Required on the server environment for admin operations: All Accounts roster, tenant provisioning, user status management
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server-only exam generation quotas
AI_HOURLY_USER_LIMIT=5
AI_DAILY_SCHOOL_LIMIT=100

# Shared helper token (server-only; never use NEXT_PUBLIC_). Configure the same value as helper/HELPER_TOKEN.
GEMINI_HELPER_TOKEN=replace-with-a-long-random-helper-token
